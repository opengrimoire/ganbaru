        },
        {
          "url": "https://github.com/opengrimoire/ganbaru/blob/main/LICENSE"
        },
        {
          "url": "https://github.com/opengrimoire/ganbaru/blob/main/apps/client/static/sfx/*"
        },
        {
          "url": "https://developers.notion.com/guides/get-started/authorization"
        },
        {
