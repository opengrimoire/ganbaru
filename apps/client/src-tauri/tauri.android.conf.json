{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ganbaru",
  "build": {
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ganbaru",
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["android"],
      "csp": {
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "frame-src": "http://127.0.0.1:* http://localhost:*"
      },
      "devCsp": {
        "default-src": "'self' http://*:*",
        "script-src": "'self' 'unsafe-eval' http://*:*",
        "style-src": "'self' 'unsafe-inline' http://*:*",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://127.0.0.1:* http://localhost:* http://*:*",
        "media-src": "'self' http://127.0.0.1:* http://localhost:* http://*:*",
        "font-src": "'self' http://*:*",
        "connect-src": "ipc: http://ipc.localhost http://*:* ws://*:*",
        "frame-src": "http://127.0.0.1:* http://localhost:*"
      }
    }
  },
  "bundle": {
    "android": {
      "debugApplicationIdSuffix": ".dev",
      "minSdkVersion": 29
    }
  }
}
