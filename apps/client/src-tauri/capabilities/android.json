{
  "identifier": "android",
  "description": "Android capability for the single app-owned webview",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "ganbaru-mobile-notifications:allow-calendarChannelStatus",
    "ganbaru-mobile-notifications:allow-scheduleCalendarNotifications",
    "ganbaru-mobile-notifications:allow-pendingCalendarNotifications",
    "ganbaru-mobile-notifications:allow-cancelCalendarNotifications",
    "ganbaru-mobile-notifications:allow-takeCalendarNotificationAction",
    "ganbaru-mobile-notifications:allow-reconcilePomodoroSchedule",
    "ganbaru-mobile-distractions:allow-accessStatus",
    "ganbaru-mobile-distractions:allow-openUsageAccessSettings",
    "ganbaru-mobile-distractions:allow-openAccessibilitySettings",
    "ganbaru-mobile-distractions:allow-listLaunchableApps",
    "ganbaru-mobile-distractions:allow-takeNotificationAction",
    {
