{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ganbaru",
  "build": {
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ganbaru",
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["android"],
      "csp": {
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://*:1420",
        "script-src": "'self' 'unsafe-eval' http://*:1420",
        "style-src": "'self' 'unsafe-inline' http://*:1420",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://127.0.0.1:* http://localhost:* http://*:*",
        "media-src": "'self' http://127.0.0.1:* http://localhost:* http://*:*",
        "font-src": "'self' http://*:1420",
        "connect-src": "ipc: http://ipc.localhost http://*:1420 ws://*:1420 ws://*:1421",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "android": {
      "debugApplicationIdSuffix": ".dev",
      "minSdkVersion": 29
    }
  }
}
